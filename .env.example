# Copy this file to ".env" and adjust. The .env file is git-ignored.
#after comeleted we have to convert file name to .env
# Database backend: "sqlite" (single PC / dev) or "postgresql" (LAN / prod)
TIMBER_DB_BACKEND=sqlite

# PostgreSQL settings (only used when TIMBER_DB_BACKEND=postgresql)
TIMBER_PG_HOST=192.168.1.100
TIMBER_PG_PORT=5432
TIMBER_PG_USER=timber
TIMBER_PG_PASSWORD=change-me
TIMBER_PG_DB=timber

# UI language: "ur" (Urdu) or "en" (English)
TIMBER_LANG=ur
