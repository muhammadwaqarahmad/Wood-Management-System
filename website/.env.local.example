# LOCAL DEV: you do NOT need this file. Leave NEXT_PUBLIC_API_URL unset and the
# Next dev server proxies /api to the backend at 127.0.0.1:8000 (see
# next.config.mjs) — no CORS, no localhost/IPv6 issues.
#
# PRODUCTION ONLY: point the site at the deployed API's real URL:
# NEXT_PUBLIC_API_URL=https://your-api-domain.com
