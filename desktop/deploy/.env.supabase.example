# ==========================================================================
#  Abdul Sattar Woods — .env for connecting to Supabase (cloud PostgreSQL)
# --------------------------------------------------------------------------
#  Copy this file to ".env" and place it NEXT TO the exe on every PC.
#  Fill in the values from your Supabase project's "Connection string"
#  (Project Settings -> Database -> Connection Pooling -> "Session" mode).
#  NOTE: use the POOLER host (aws-0-<region>.pooler.supabase.com), NOT the
#  direct db.<ref>.supabase.co host — the pooler gives IPv4, which office PCs
#  need. Use Session mode (port 5432 on the pooler).
# ==========================================================================

TIMBER_DB_BACKEND=postgresql

# --- Supabase connection (from the pooler, SESSION mode) ---
# NOTE: for the real, ready-to-copy file see deploy/ASW-CLOUD.env — this is
# just the generic template. Region below is Singapore (ap-southeast-1).
TIMBER_PG_HOST=aws-0-ap-southeast-1.pooler.supabase.com
TIMBER_PG_PORT=5432
TIMBER_PG_USER=postgres.piqrfdwirbpbfcdibdmh
TIMBER_PG_PASSWORD=YOUR-DB-PASSWORD-HERE
TIMBER_PG_DB=postgres

# --- TLS is REQUIRED by Supabase ---
TIMBER_PG_SSLMODE=require

# --- resilience (already tuned; leave as-is unless advised) ---
TIMBER_PG_CONNECT_TIMEOUT=8
TIMBER_PG_STATEMENT_TIMEOUT=30000

# --- housekeeping ---
TIMBER_AUDIT_RETENTION_DAYS=3

# --- master data seeding: OFF. The live master data lives in the shared
#     cloud DB. To seed a brand-new empty Supabase ONCE, temporarily set this
#     to 1 and launch on ONE pc, or run: python -m timber.db.seed_master ---
TIMBER_SEED_MASTER_DATA=0

# --- language default (ur | en) ---
TIMBER_LANG=ur
