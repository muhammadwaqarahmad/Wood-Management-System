# Cloud API environment — copy to cloud-api.env and fill the two secrets.
# Used for local Docker testing and as a reference for the host's dashboard vars.
# 🔒 Never commit the real password/secret. Set them in the host dashboard.

TIMBER_DB_BACKEND=postgresql
TIMBER_PG_HOST=aws-0-ap-southeast-1.pooler.supabase.com
TIMBER_PG_PORT=5432
TIMBER_PG_USER=postgres.piqrfdwirbpbfcdibdmh
TIMBER_PG_DB=postgres
TIMBER_PG_SSLMODE=require
TIMBER_PG_CONNECT_TIMEOUT=8
TIMBER_AUDIT_RETENTION_DAYS=3
TIMBER_API_CORS=*

# ---- SECRETS (fill these) ----
TIMBER_PG_PASSWORD=your-supabase-db-password
TIMBER_API_SECRET=paste-a-long-random-string-here
