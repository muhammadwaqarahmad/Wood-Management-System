*.sqlite
*.sqlite3
*.db
*.dump

# Mobile (Flutter) build artifacts — never commit builds
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/ios/Pods/
*.apk
*.aab

# Scratch / big binaries
AbdulSattarWoods.apk

# Generated export artifacts at the repo root (were accidentally committed once).
