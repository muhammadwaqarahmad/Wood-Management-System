# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment
.venv/
venv/

# Runtime data (db, backups, reports, logs)
storage/

# Secrets — ALL real env files (deploy/ASW-CLOUD.env, CLIENT-PC.env, MAIN-SERVER.env
